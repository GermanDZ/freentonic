#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "optparse"
require "fileutils"
require "freentonic"
require "freentonic/invoke_request"
require "freentonic/invoke_runner"
require "freentonic/invoke_server"
require "freentonic/simplefin/feature"
require "freentonic/simplefin/router"
require "freentonic/simplefin/sync_queue"

options = {
  listen_addr:         ENV["FREENTONIC_LISTEN_ADDR"] || Freentonic::InvokeServer::DEFAULT_ADDR,
  listen_port:         (ENV["FREENTONIC_LISTEN_PORT"]  || Freentonic::InvokeServer::DEFAULT_PORT).to_i,
  workflows_dir:       ENV["FREENTONIC_WORKFLOWS_DIR"] || Freentonic::InvokeRunner::DEFAULT_WORKFLOWS_DIR,
  runs_dir:            ENV["FREENTONIC_RUNS_DIR"]      || Freentonic::InvokeRunner::DEFAULT_RUNS_DIR,
  tmpfs_dir:           ENV["FREENTONIC_TMPFS_DIR"]     || Freentonic::InvokeRunner::DEFAULT_TMPFS_DIR,
  chrome_profile_root: ENV["FREENTONIC_CHROME_PROFILE_ROOT"] || Freentonic::InvokeRunner::DEFAULT_CHROME_PROFILE_ROOT,
  vnc_password_file:   ENV["FREENTONIC_VNC_PASSWORD_FILE"]   || Freentonic::InvokeRunner::DEFAULT_VNC_PASSWORD_FILE,
  invoke_token:        ENV["FREENTONIC_INVOKE_TOKEN"]
}

OptionParser.new do |opts|
  opts.banner = "Usage: freentonic-server [options]"
  opts.on("--listen-addr ADDR",      "Bind address (default #{options[:listen_addr]})") { |v| options[:listen_addr] = v }
  opts.on("--listen-port PORT", Integer, "Port (default #{options[:listen_port]})") { |v| options[:listen_port] = v }
  opts.on("--workflows-dir DIR",     "Workflows root (default #{options[:workflows_dir]})") { |v| options[:workflows_dir] = v }
  opts.on("--runs-dir DIR",          "Runs output root (default #{options[:runs_dir]})") { |v| options[:runs_dir] = v }
  opts.on("--tmpfs-dir DIR",         "Tmpfs secrets root (default #{options[:tmpfs_dir]})") { |v| options[:tmpfs_dir] = v }
  opts.on("--chrome-profile-root DIR", "Chrome profile root (default #{options[:chrome_profile_root]})") { |v| options[:chrome_profile_root] = v }
  opts.on("--vnc-password-file PATH", "x11vnc passwdfile, rotated per invoke (default #{options[:vnc_password_file]})") { |v| options[:vnc_password_file] = v }
  opts.on("--invoke-token TOKEN",    "Bearer token (or set FREENTONIC_INVOKE_TOKEN)") { |v| options[:invoke_token] = v }
  opts.on("-h", "--help") { puts opts; exit 0 }
  opts.on("--version") { puts "freentonic-server #{Freentonic::VERSION}"; exit 0 }
end.parse!(ARGV)

# Sweep any leftover tmpfs run dirs from a prior crash so next-invoke
# EXCL file creation doesn't trip over stale state.
if Dir.exist?(options[:tmpfs_dir])
  Dir.glob(File.join(options[:tmpfs_dir], "*")).each do |path|
    begin
      FileUtils.rm_rf(path)
    rescue StandardError => e
      warn "[freentonic-server] startup sweep: could not remove #{path}: #{e.message}"
    end
  end
end

runner = Freentonic::InvokeRunner.new(
  workflows_dir:       options[:workflows_dir],
  runs_dir:            options[:runs_dir],
  tmpfs_dir:           options[:tmpfs_dir],
  chrome_profile_root: options[:chrome_profile_root],
  vnc_password_file:   options[:vnc_password_file],
  logger:              ->(msg) { $stdout.puts("[invoke-runner] #{msg}") }
)

simplefin_router = nil
simplefin_feature = nil

if Freentonic::Simplefin::Feature.enabled?
  simplefin_feature = Freentonic::Simplefin::Feature.from_env(
    logger: ->(msg) { $stdout.puts(msg) }
  )
  simplefin_feature.recover_on_boot!
  ui_dir = File.expand_path("../lib/freentonic/simplefin/ui", __dir__)
  simplefin_router = Freentonic::Simplefin::Router.new(
    feature:       simplefin_feature,
    workflows_dir: options[:workflows_dir],
    runs_dir:      options[:runs_dir],
    asset_dir:     ui_dir
  )
end

server = Freentonic::InvokeServer.new(
  runner:            runner,
  invoke_token:      options[:invoke_token],
  listen_addr:       options[:listen_addr],
  listen_port:       options[:listen_port],
  logger:            $stdout,
  simplefin_router:  simplefin_router
)

if simplefin_feature
  queue = Freentonic::Simplefin::SyncQueue.new(
    feature:       simplefin_feature,
    runner:        runner,
    invoke_mutex:  server.invoke_mutex,
    workflows_dir: options[:workflows_dir]
  ).start
  simplefin_feature.install_queue(queue)
  simplefin_feature.start_housekeeper
end

%w[TERM INT].each do |sig|
  Signal.trap(sig) do
    server.shutdown
    # Thread-unsafe to call from a real signal handler beyond this; the
    # queue stop uses a Mutex internally. In practice the VM defers the
    # block via Thread.handle_interrupt semantics for mutex-guarded code,
    # and even in the worst case we'd just lose a pending sync (which
    # the in-memory-queue design already tolerates).
  end
end

server.start
queue&.stop
simplefin_feature&.stop_housekeeper
