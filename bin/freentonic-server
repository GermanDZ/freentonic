#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "optparse"
require "freentonic"
require "freentonic/invoke_request"
require "freentonic/invoke_runner"
require "freentonic/invoke_server"

options = {
  listen_addr:         ENV["FREENTONIC_LISTEN_ADDR"] || Freentonic::InvokeServer::DEFAULT_ADDR,
  listen_port:         (ENV["FREENTONIC_LISTEN_PORT"]  || Freentonic::InvokeServer::DEFAULT_PORT).to_i,
  workflows_dir:       ENV["FREENTONIC_WORKFLOWS_DIR"] || Freentonic::InvokeRunner::DEFAULT_WORKFLOWS_DIR,
  runs_dir:            ENV["FREENTONIC_RUNS_DIR"]      || Freentonic::InvokeRunner::DEFAULT_RUNS_DIR,
  chrome_profile_root: ENV["FREENTONIC_CHROME_PROFILE_ROOT"] || Freentonic::InvokeRunner::DEFAULT_CHROME_PROFILE_ROOT,
  secrets_dir:         ENV["FREENTONIC_SECRETS_DIR"]  || Freentonic::InvokeRunner::DEFAULT_SECRETS_DIR,
  vnc_password_file:   ENV["FREENTONIC_VNC_PASSWORD_FILE"]   || Freentonic::InvokeRunner::DEFAULT_VNC_PASSWORD_FILE,
  session_idle_timeout: (ENV["FREENTONIC_SESSION_IDLE_TIMEOUT"] || Freentonic::InvokeServer::DEFAULT_SESSION_IDLE_TIMEOUT).to_i,
  invoke_tokens:       [],
  invoke_token_files:  []
}

OptionParser.new do |opts|
  opts.banner = "Usage: freentonic-server [options]"
  opts.on("--listen-addr ADDR",      "Bind address (default #{options[:listen_addr]})") { |v| options[:listen_addr] = v }
  opts.on("--listen-port PORT", Integer, "Port (default #{options[:listen_port]})") { |v| options[:listen_port] = v }
  opts.on("--workflows-dir DIR",     "Workflows root (default #{options[:workflows_dir]})") { |v| options[:workflows_dir] = v }
  opts.on("--runs-dir DIR",          "Runs output root (default #{options[:runs_dir]})") { |v| options[:runs_dir] = v }
  opts.on("--chrome-profile-root DIR", "Chrome profile root (default #{options[:chrome_profile_root]})") { |v| options[:chrome_profile_root] = v }
  opts.on("--secrets-dir DIR",       "credentials.file root (default #{options[:secrets_dir]})") { |v| options[:secrets_dir] = v }
  opts.on("--vnc-password-file PATH", "x11vnc passwdfile, rotated per invoke (default #{options[:vnc_password_file]})") { |v| options[:vnc_password_file] = v }
  opts.on("--session-idle-timeout SEC", Integer, "Close a held /sessions step session idle for this many seconds (default #{options[:session_idle_timeout]})") { |v| options[:session_idle_timeout] = v }
  opts.on("--invoke-token TOKEN",    "Bearer token (repeatable; or FREENTONIC_INVOKE_TOKEN, comma-separated)") { |v| options[:invoke_tokens] << v }
  opts.on("--invoke-token-file PATH", "File of bearer tokens, one per line (repeatable; or FREENTONIC_INVOKE_TOKEN_FILE)") { |v| options[:invoke_token_files] << v }
  opts.on("-h", "--help") { puts opts; exit 0 }
  opts.on("--version") { puts "freentonic-server #{Freentonic::VERSION}"; exit 0 }
end.parse!(ARGV)

begin
  invoke_tokens = Freentonic::InvokeServer.load_tokens(
    cli_tokens:     options[:invoke_tokens],
    cli_files:      options[:invoke_token_files],
    env_token:      ENV["FREENTONIC_INVOKE_TOKEN"],
    env_token_file: ENV["FREENTONIC_INVOKE_TOKEN_FILE"]
  )
rescue Freentonic::UserError => e
  warn "freentonic-server: #{e.message}"
  exit 2
end

runner = Freentonic::InvokeRunner.new(
  workflows_dir:       options[:workflows_dir],
  runs_dir:            options[:runs_dir],
  chrome_profile_root: options[:chrome_profile_root],
  secrets_dir:         options[:secrets_dir],
  vnc_password_file:   options[:vnc_password_file],
  logger:              ->(msg) { $stdout.puts("[invoke-runner] #{msg}") }
)

server = Freentonic::InvokeServer.new(
  runner:               runner,
  invoke_tokens:        invoke_tokens,
  listen_addr:          options[:listen_addr],
  listen_port:          options[:listen_port],
  session_idle_timeout: options[:session_idle_timeout],
  logger:               $stdout
)

%w[TERM INT].each do |sig|
  Signal.trap(sig) { server.shutdown }
end

server.start
